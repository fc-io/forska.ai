{
  "$schema": "./hpc_config_schema.json",
  "name": "mn5",
  "displayName": "MareNostrum 5 ACC",
  "description": "Barcelona Supercomputing Center MareNostrum 5 Accelerated Partition",
  "provider": "BSC (Barcelona Supercomputing Center)",

  "hardware": {
    "node": {
      "cpuModel": "Intel Xeon Platinum 8460Y+ 40C 2GHz",
      "cpuCoresPerNode": 80,
      "cpuSockets": 2,
      "memoryGb": 512,
      "memoryType": "DDR5",
      "memorySpeed": "4800MHz",
      "localStorageGb": 480,
      "localStorageType": "NVMe"
    },
    "gpu": {
      "model": "NVIDIA H100",
      "memoryGb": 64,
      "memoryType": "HBM2",
      "gpusPerNode": 4
    },
    "network": {
      "type": "InfiniBand",
      "model": "ConnectX-7 NDR200",
      "bandwidthGbps": 800,
      "nicsPerNode": 4
    },
    "cluster": {
      "totalNodes": 1120,
      "totalGpus": 4480
    }
  },

  "defaults": {
    "GPU_NNODES": 2,
    "GPU_GPUS_PER_NODE": 4,
    "GPU_TOTAL_GPUS": 8,
    "TP_SIZE": 8,
    "DP_SIZE": 1,
    "GPU_SHAPE": "H100:4",
    "SGLANG_MAX_RUNNING_REQUESTS": 128,
    "SGLANG_MODEL": "XiaomiMiMo/MiMo-V2-Flash"
  },

  "sglang": {
    "model": "XiaomiMiMo/MiMo-V2-Flash",
    "servedModelName": "XiaomiMiMo/MiMo-V2-Flash",
    "port": 30000,
    "tensorParallelSize": 8,
    "dataParallelSize": 1,
    "contextLength": 131072,
    "chunkedPrefillSize": 16384,
    "maxRunningRequests": 128,
    "memFractionStatic": 0.75,
    "reasoningParser": "qwen3"
  },

  "connection": {
    "transferNode": "transfer4.bsc.es",
    "generalLogin": "glogin1.bsc.es",
    "accLogin": "alogin2.bsc.es",
    "sshConfigHosts": {
      "transfer": "tlog",
      "general": "glog",
      "acc": "alog"
    },
    "storageRoot": "/gpfs/projects/ehpc482/dev",
    "slurmAccount": "ehpc482",
    "slurmQos": "acc_ehpc"
  },

  "notes": [
    "MN5 has NO outbound internet access - all models/containers must be pre-transferred",
    "MiMo-V2-Flash requires 2 nodes (tp=8) for inference",
    "Large models can take 15-20 minutes to load",
    "SSH tunnel required for local API server to reach SGLang",
    "Using dp=1 (not dp=2): request-level parallelism via max_running_requests=128 is sufficient for batch judging",
    "LMSYS dp=2 benchmark config is for peak throughput; dp=1 is simpler and better for production stability"
  ]
}
