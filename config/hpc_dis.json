{
  "$schema": "./hpc_config_schema.json",
  "name": "dis",
  "displayName": "DIS",
  "description": "DIS (Digital Infrastructure for Science) GPU cluster",
  "provider": "EuroHPC / DIS",

  "hardware": {
    "gpu": {
      "model": "NVIDIA H200",
      "memoryGb": 80,
      "memoryType": "HBM3",
      "gpusPerNode": 2
    },
    "network": {
      "type": "InfiniBand"
    }
  },

  "defaults": {
    "GPU_NNODES": 1,
    "GPU_GPUS_PER_NODE": 2,
    "GPU_TOTAL_GPUS": 2,
    "TP_SIZE": 1,
    "DP_SIZE": 1,
    "GPU_SHAPE": "H200:2",
    "SGLANG_MAX_RUNNING_REQUESTS": 256,
    "SGLANG_MODEL": "Qwen/Qwen3-30B-A3B-Instruct-2507"
  },

  "sglang": {
    "model": "Qwen/Qwen3-30B-A3B-Instruct-2507",
    "port": 30000,
    "tensorParallelSize": 1,
    "dataParallelSize": 1,
    "chunkedPrefillSize": 16384,
    "maxRunningRequests": 256,
    "memFractionStatic": 0.92,
    "schedulePolicy": "lpm",
    "routerPolicy": "cache_aware"
  },

  "connection": {
    "sshConfigHosts": {
      "login": "dis"
    },
    "storageRoot": "/valhalla/projects/ehpc-aif-2025pg01-233/dev",
    "slurmAccount": "ehpc-aif-2025pg01-233",
    "slurmQos": "ehpc-aif-2025pg01-233",
    "slurmPartition": "common"
  },

  "notes": [
    "One-worker-per-GPU mode enabled by default",
    "H200 GPUs allow tp=1 for 30B models",
    "Standard allocation: 2x H200 per node"
  ]
}
