{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hpc_config_schema.json",
  "title": "HPC Configuration",
  "description": "Configuration schema for HPC cluster setups used by forska.ai",
  "type": "object",
  "required": ["name", "displayName", "hardware", "defaults"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "name": {
      "type": "string",
      "description": "Short identifier for the HPC cluster (e.g., 'mn5', 'alvis', 'dis')"
    },
    "displayName": {
      "type": "string",
      "description": "Human-readable name for the cluster"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the cluster"
    },
    "provider": {
      "type": "string",
      "description": "Organization/center providing the HPC resource"
    },
    "hardware": {
      "type": "object",
      "description": "Hardware specifications",
      "required": ["gpu"],
      "properties": {
        "node": {
          "type": "object",
          "properties": {
            "cpuModel": { "type": "string" },
            "cpuCoresPerNode": { "type": "integer" },
            "cpuSockets": { "type": "integer" },
            "memoryGb": { "type": "integer" },
            "memoryType": { "type": "string" },
            "memorySpeed": { "type": "string" },
            "localStorageGb": { "type": "integer" },
            "localStorageType": { "type": "string" }
          }
        },
        "gpu": {
          "type": "object",
          "required": ["model", "memoryGb", "gpusPerNode"],
          "properties": {
            "model": {
              "type": "string",
              "description": "GPU model name (e.g., 'NVIDIA H100', 'NVIDIA A100')"
            },
            "memoryGb": {
              "type": "integer",
              "description": "GPU memory in GB"
            },
            "memoryType": {
              "type": "string",
              "description": "GPU memory type (e.g., 'HBM2', 'HBM2e', 'HBM3')"
            },
            "gpusPerNode": {
              "type": "integer",
              "description": "Number of GPUs per compute node"
            },
            "variant": {
              "type": "string",
              "description": "GPU variant identifier (e.g., 'A100fat', 'A100')"
            }
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "model": { "type": "string" },
            "bandwidthGbps": { "type": "integer" },
            "nicsPerNode": { "type": "integer" }
          }
        },
        "cluster": {
          "type": "object",
          "properties": {
            "totalNodes": { "type": "integer" },
            "totalGpus": { "type": "integer" }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Default environment variable values for this cluster",
      "required": ["GPU_NNODES", "GPU_GPUS_PER_NODE", "GPU_TOTAL_GPUS", "TP_SIZE", "DP_SIZE"],
      "properties": {
        "GPU_NNODES": {
          "type": "integer",
          "description": "Number of nodes to allocate"
        },
        "GPU_GPUS_PER_NODE": {
          "type": "integer",
          "description": "GPUs per node"
        },
        "GPU_TOTAL_GPUS": {
          "type": "integer",
          "description": "Total GPUs (NNODES × GPUS_PER_NODE)"
        },
        "TP_SIZE": {
          "type": "integer",
          "description": "Tensor parallel size"
        },
        "DP_SIZE": {
          "type": "integer",
          "description": "Data parallel size"
        },
        "GPU_SHAPE": {
          "type": "string",
          "description": "GPU shape identifier (e.g., 'H100:4', 'A100:3')"
        },
        "SGLANG_MAX_RUNNING_REQUESTS": {
          "type": "integer",
          "description": "Maximum concurrent requests per SGLang engine"
        },
        "SGLANG_MODEL": {
          "type": "string",
          "description": "Default model to load"
        }
      }
    },
    "sglang": {
      "type": "object",
      "description": "SGLang-specific configuration",
      "properties": {
        "model": { "type": "string" },
        "servedModelName": { "type": "string" },
        "port": { "type": "integer" },
        "tensorParallelSize": { "type": "integer" },
        "dataParallelSize": { "type": "integer" },
        "contextLength": { "type": "integer" },
        "chunkedPrefillSize": { "type": "integer" },
        "maxRunningRequests": { "type": "integer" },
        "memFractionStatic": { "type": "number" },
        "reasoningParser": { "type": "string" }
      }
    },
    "connection": {
      "type": "object",
      "description": "SSH/Slurm connection details",
      "properties": {
        "transferNode": { "type": "string" },
        "generalLogin": { "type": "string" },
        "accLogin": { "type": "string" },
        "sshConfigHosts": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "storageRoot": { "type": "string" },
        "slurmAccount": { "type": "string" },
        "slurmQos": { "type": "string" },
        "slurmPartition": { "type": "string" }
      }
    },
    "notes": {
      "type": "array",
      "description": "Important notes about this cluster",
      "items": { "type": "string" }
    }
  }
}
