FROM lmsysorg/sglang:latest

# This Dockerfile is DEPRECATED - SGLang v0.5.4+ uses unified launch_server architecture
# Use the official lmsysorg/sglang:latest image directly with: python -m sglang.launch_server
# Kept for reference only

ARG SGLANG_VERSION=0.5.4.post3

ENV HF_HOME=/cache/hf \
    XDG_CACHE_HOME=/cache/xdg

EXPOSE 30000

# Updated for SGLang v0.5.4+ unified server architecture
ENTRYPOINT ["python", "-m", "sglang.launch_server"]
