{
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(bunx tsc:*)",
      "Bash(bunx eslint:*)",
      "Bash(curl:*)",
      "Bash(chmod:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:api.github.com)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": [],
    "networkAccess": [
      "localhost",
      "127.0.0.1"
    ],
    "autoAllowBashIfSandboxed": true
  }
}
