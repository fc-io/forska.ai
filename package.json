{
  "name": "forska.ai",
  "version": "0.1.51",
  "type": "module",
  "scripts": {
    "start": "bun run start:build && bun run start:server & bun run start:app-server",
    "start:secondary": "bun run start:build && bun run start:secondary:server & bun run start:secondary:app-server",
    "start:build": "bun run build",
    "start:server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode server-stack",
    "start:secondary:server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode server-stack",
    "start:server:single": "bun run src/server/index.ts",
    "start:app-server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode app-server",
    "start:secondary:app-server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode app-server",
    "app": "bun run build && bun run preview",
    "build": "bunx --bun vite build",
    "build:docker": "bun scripts/buildDockerHostnet.ts",
    "build:docker:sglang": "bun scripts/buildDockerSglang.ts",
    "alvis:sglang:pull": "bun scripts/alvisSglangPull.ts",
    "bench:articlesreviews": "bun scripts/benchmarkArticlesReviews.ts",
    "bench:duckdb-append-lanes": "bun scripts/benchmarkDuckdbAppendLanes.ts",
    "preview": "bunx --bun vite preview",
    "test": "bun test",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "dev:app": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode app",
    "dev:server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode stacked-server",
    "dev:server:bun-watch": "BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:single": "BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:api": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode api-only-server",
    "dev:server:worker": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode worker-only-server",
    "dev:server:no-writer": "SERVER_ROLE=api SERVER_WRITER_URL= BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:writer": "SERVER_ROLE=worker BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:secondary:server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode stacked-server",
    "dev:secondary:app": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode app",
    "dev:secondary:server:api": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode api-only-server",
    "dev:secondary:server:worker": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode worker-only-server",
    "db:mig": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode duckdb-migration",
    "db:mig:secondary": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode duckdb-migration",
    "db:duck:mig": "bun run db:mig",
    "db:triggers": "bun src/db/addUpdatedAtTriggers.ts",
    "db:backup": "bun scripts/dbBackup.ts",
    "db:backup-from-remote": "bun scripts/dbRemoteBackup.ts",
    "db:merge-from-remote-dump": "bun scripts/dbMergeRemoteDump.ts",
    "db:merge-from-remote-dump-safe": "bun scripts/dbMergeRemoteDumpSafe.ts",
    "db:repair-judgments-index": "bun scripts/dbRepairJudgmentsIndex.ts",
    "db:reindex-all": "bun scripts/dbReindexAll.ts",
    "db:repair-all-indexes": "bun scripts/dbRepairAllIndexes.ts",
    "db:judgment-job:sqlite-import": "bun scripts/runJudgmentJobSqliteSingleJobImport.ts",
    "db:judgment-job:repair": "bun scripts/runJudgmentJobRepair.ts",
    "db:backfill-prompt-hash": "bun scripts/dbBackfillPromptHash.ts",
    "db:import:postgres-to-duckdb": "bun scripts/importPostgresToDuckdb.ts --clear",
    "db:import:postgres-to-duckdb:with-marts": "bun scripts/importPostgresToDuckdb.ts --clear --rebuild-marts",
    "db:import:postgres-to-duckdb:resume": "bun scripts/importPostgresToDuckdb.ts --resume",
    "db:duck:checkpoint": "bun scripts/duckdbCheckpoint.ts",
    "db:query:snapshot": "bun scripts/dbQuerySnapshot.ts",
    "db:duck:inspect-project-refresh-risk": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/inspectProjectMartRefreshRisk.ts",
    "db:duck:refresh-project-once": "SERVER_ROLE=writer SERVER_WRITER_URL= bunx tsx scripts/runProjectMartRefreshWorkerOnceIsolated.ts",
    "db:duck:run-large-rebuild-cycle": "SERVER_ROLE=writer SERVER_WRITER_URL= bunx tsx scripts/runProjectMartLargeRebuildCycle.ts",
    "db:duck:run-large-rebuild-cycles": "SERVER_ROLE=writer SERVER_WRITER_URL= bunx tsx scripts/runProjectMartLargeRebuildCycles.ts",
    "db:duck:quarantine-refresh-article": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/quarantineProjectMartRefreshArticle.ts",
    "db:duck:unquarantine-refresh-article": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/unquarantineProjectMartRefreshArticle.ts",
    "db:duck:recover-project-refresh-claims": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/recoverProjectMartRefreshClaims.ts",
    "db:duck:repair-project-refresh-ledger": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/repairProjectMartRefreshLedger.ts",
    "db:duck:repair-judgment-fact": "SERVER_ROLE=writer SERVER_WRITER_URL= bun scripts/repairJudgmentFactTable.ts",
    "db:duck:rebuild-marts": "bun scripts/backfillReviewServingV3.ts",
    "db:duck:backfill-review-serving-v3": "bun scripts/backfillReviewServingV3.ts",
    "db:duck:purge-archived-marts": "bun scripts/purgeArchivedProjectMarts.ts",
    "db:duck:recover-archived-refresh-queue": "bun scripts/recoverArchivedProjectRefreshQueue.ts",
    "db:duck:backfill-source-metadata": "bun scripts/backfillArticleSourceMetadata.ts",
    "db:duck:backfill-ppr-host-labels": "bun scripts/backfillPprHostLabels.ts",
    "db:studio": "bun scripts/dbStudio.ts",
    "db:r:p": "bun scripts/dbPush.ts --force --no-restore",
    "db:r:pull": "bun scripts/dbRemotePull.ts",
    "db:reset": "bun scripts/dbClear.ts --drop --force",
    "f:p": "bun scripts/sbatchPut.ts",
    "dis:db:merge-from-remote-dump": "bun scripts/dbMergeRemoteDump.ts",
    "dis:db:r:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev bun scripts/dbPush.ts --force --no-restore",
    "dis:f:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev SBATCH_FILE=forska-dis.sbatch bun scripts/sbatchPut.ts",
    "alvis:f:p": "SSH_ALIAS=alvis2 STACK_ROOT=/mimer/NOBACKUP/groups/clin-agent-bench/dev SBATCH_FILE=forska-alvis.sbatch bun scripts/sbatchPut.ts",
    "alvis:sbatch:push": "SSH_ALIAS=alvis2 STACK_ROOT=/mimer/NOBACKUP/groups/clin-agent-bench/dev SBATCH_FILE=forska-alvis.sbatch bun scripts/sbatchPut.ts",
    "alvis:status": "ssh alvis2 'squeue -u $USER'",
    "alvis:launch": "bun scripts/alvisLaunch.ts",
    "alvis:launch:a100:fat": "bun scripts/alvisLaunch.ts --a100-fat",
    "alvis:launch:a100:4": "bun scripts/alvisLaunch.ts --a100-4",
    "alvis:smi": "bun scripts/alvisSmi.ts",
    "alvis:dev:server": "bun scripts/alvisDevServer.ts",
    "mn5:f:p": "scp forska-mn5-sglang.sbatch tlog:/gpfs/projects/ehpc482/dev/",
    "mn5:transfer": "bun scripts/mn5Transfer.ts",
    "mn5:sbatch:push": "scp forska-mn5-sglang.sbatch tlog:/gpfs/projects/ehpc482/dev/",
    "mn5:status": "ssh alog 'squeue -u $USER'",
    "mn5:tunnel": "bun scripts/mn5Tunnel.ts",
    "mn5:smi": "bun scripts/mn5Smi.ts",
    "mn5:launch": "bun scripts/mn5Launch.ts",
    "mn5:mount": "mkdir -p ~/mnt/mn5 && sshfs tlog:/gpfs/projects/ehpc482/dev ~/mnt/mn5 -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 && echo 'Mounted at ~/mnt/mn5'",
    "mn5:unmount": "umount ~/mnt/mn5 && echo 'Unmounted'",
    "mn5:dev:server": "bun scripts/mn5DevServer.ts",
    "docling:alvis:launch": "bun scripts/doclingAlvisLaunch.ts",
    "docling:alvis:status": "ssh alvis2 'squeue -u $USER -n forska-docling'",
    "docling:alvis:cancel": "ssh alvis2 'scancel -u $USER -n forska-docling'",
    "docling:alvis:logs": "ssh alvis2 'tail -f /mimer/NOBACKUP/groups/clin-agent-bench/dev/logs/*/docling.log'"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@ark-ui/solid": "^5.34.1",
