{
  "name": "forska.ai",
  "version": "1.0.50",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:app": "bunx --bun vite",
    "dev:app-static": "bun run build && bun run preview",
    "d:push": "bunx --bun drizzle-kit push",
    "d:studio": "bun --env-file=.env.local run drizzle-kit studio",
    "d:auth": "bunx --bun @better-auth/cli@latest generate",
    "d:gen": "bunx --bun drizzle-kit generate",
    "d:migrate": "bunx --bun drizzle-kit migrate",
    "db:triggers": "bun src/db/addUpdatedAtTriggers.ts"
  },
  "dependencies": {
    "@better-auth/cli": "^1.3.4",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/eden": "^1.3.2",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/solid-router": "^1.130.12",
    "@tanstack/solid-router-devtools": "^1.130.13",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "arktype": "^2.1.20",
    "better-auth": "^1.3.4",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "elysia": "latest",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.130.16",
    "@types/bun": "^1.2.19",
    "@types/pg": "^8.15.5",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4",
    "drizzle-seed": "^0.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-vitest": "^0.5.4",
    "jiti": "^2.5.1",
    "tsx": "^4.20.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  },
  "module": "src/index.js"
}
