{
  "name": "forska.ai",
  "version": "1.0.51",
  "type": "module",
  "scripts": {
    "app": "bun --env-file=.env.local run build && bun --env-file=.env.local run preview",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "test": "bun test",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "dev:app": "bunx --env-file=.env.local --bun vite",
    "dev:server": "bun run --watch src/server/index.ts",
    "db:gen": "bunx --bun drizzle-kit generate",
    "db:mig": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:ba-mig": "bunx --bun @better-auth/cli migrate",
    "db:ba-gen": "bunx --bun @better-auth/cli generate",
    "db:triggers": "bun src/db/addUpdatedAtTriggers.ts",
    "db:clear": "bun src/db/clearDatabase.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:seed-auth": "bun src/seedAuth.ts",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.9",
    "@ark-ui/solid": "^5.18.3",
    "@better-auth/cli": "^1.3.4",
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/cron": "^1.3.0",
    "@elysiajs/eden": "^1.3.2",
    "@eslint/js": "^9.32.0",
    "@internationalized/date": "^3.8.2",
    "@kobalte/core": "^0.13.11",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/solid-query": "^5.83.1",
    "@tanstack/solid-router": "^1.130.12",
    "@tanstack/solid-router-devtools": "^1.130.13",
    "@tanstack/solid-table": "^8.21.3",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "ai": "^5.0.9",
    "arktype": "^2.1.20",
    "better-auth": "^1.3.4",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "elysia": "latest",
    "fast-xml-parser": "^5.2.5",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "solid-chartjs": "^1.3.11",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@better-auth-kit/seed": "^1.0.12",
    "@tanstack/router-plugin": "^1.130.16",
    "@types/bun": "^1.2.19",
    "@types/pg": "^8.15.5",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.4",
    "drizzle-seed": "^0.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-vitest": "^0.5.4",
    "jiti": "^2.5.1",
    "tsx": "^4.20.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  },
  "module": "src/index.js"
}
