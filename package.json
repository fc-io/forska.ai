{
  "name": "forska.ai",
  "version": "0.1.51",
  "type": "module",
  "scripts": {
    "start": "bun run start:build && bun run start:server & bun run start:app-server",
    "start:build": "bun --env-file=.env run build",
    "start:server": "bun --env-file=.env run src/server/index.ts",
    "start:app-server": "bun --env-file=.env run src/appServer.ts",
    "app": "bun --env-file=.env.local run build && bun --env-file=.env.local run preview",
    "build": "bunx --bun vite build",
    "build:docker": "bun scripts/buildDockerHostnet.ts",
    "preview": "bunx --bun vite preview",
    "test": "bun test",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "dev:app": "bunx --env-file=.env.local --bun vite",
    "dev:server": "BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun --env-file=.env.local run --watch src/server/index.ts",
    "db:gen": "bunx --bun drizzle-kit generate",
    "db:mig": "bun src/db/migrateSqlite.ts",
    "db:push": "bunx --bun drizzle-kit push",
    "db:ba-mig": "bunx --bun @better-auth/cli migrate",
    "db:ba-gen": "bunx --bun @better-auth/cli generate",
    "db:triggers": "bun src/db/addUpdatedAtTriggers.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:seed-auth": "bun src/seedAuth.ts",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio",
    "db:backup": "bun scripts/dbBackup.ts",
    "backup": "bun scripts/fullBackup.ts",
    "db:backup-from-remote": "bun scripts/dbRemoteBackup.ts",
    "db:merge-from-remote-dump": "bun scripts/dbMergeRemoteDump.ts",
    "db:merge-from-remote-dump-safe": "bun scripts/dbMergeRemoteDumpSafe.ts",
    "db:repair-judgments-index": "bun scripts/dbRepairJudgmentsIndex.ts",
    "db:reindex-all": "bun scripts/dbReindexAll.ts",
    "db:repair-all-indexes": "bun scripts/dbRepairAllIndexes.ts",
    "db:backfill-prompt-hash": "bun --env-file=.env.local scripts/dbBackfillPromptHash.ts",
    "db:import:postgres-to-sqlite": "bun scripts/importPostgresToSqlite.ts",
    "db:r:p": "bun scripts/dbPush.ts --force --no-restore",
    "db:r:pull": "bun scripts/dbRemotePull.ts",
    "db:reset": "bun scripts/dbClear.ts --drop --force",
    "f:p": "bun scripts/sbatchPut.ts",
    "dis:db:merge-from-remote-dump": "bun scripts/dbMergeRemoteDump.ts",
    "dis:db:r:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev bun scripts/dbPush.ts --force --no-restore",
    "dis:f:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev SBATCH_FILE=forska-dis.sbatch bun scripts/sbatchPut.ts",
    "dis:oa:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev SBATCH_FILE=08-openalex-dis-db-rest.sbatch bun scripts/sbatchPut.ts",
    "dis:07:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev SBATCH_FILE=07-openalex-flatten-works.sbatch bun scripts/sbatchPut.ts",
    "dis:flatten:p": "SSH_ALIAS=dis STACK_ROOT=/valhalla/projects/ehpc-aif-2025pg01-233/dev SBATCH_FILE=flatten-openalex-jsonl.py bun scripts/sbatchPut.ts",
    "mn5:f:p": "scp forska-mn5-sglang.sbatch tlog:/gpfs/projects/ehpc482/dev/",
    "mn5:transfer": "bun scripts/mn5Transfer.ts",
    "mn5:sbatch:push": "scp forska-mn5-sglang.sbatch tlog:/gpfs/projects/ehpc482/dev/",
    "mn5:status": "ssh alog 'squeue -u $USER'",
    "mn5:tunnel": "bun scripts/mn5Tunnel.ts",
    "mn5:smi": "bun scripts/mn5Smi.ts",
    "mn5:launch": "bun scripts/mn5Launch.ts",
    "mn5:mount": "mkdir -p ~/mnt/mn5 && sshfs tlog:/gpfs/projects/ehpc482/dev ~/mnt/mn5 -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 && echo 'Mounted at ~/mnt/mn5'",
    "mn5:unmount": "umount ~/mnt/mn5 && echo 'Unmounted'",
    "mn5:dev:server": "bun scripts/mn5DevServer.ts",
    "docling:alvis:launch": "bun scripts/doclingAlvisLaunch.ts",
    "docling:alvis:status": "ssh alvis2 'squeue -u $USER -n forska-docling'",
    "docling:alvis:cancel": "ssh alvis2 'scancel -u $USER -n forska-docling'",
    "docling:alvis:logs": "ssh alvis2 'tail -f /mimer/NOBACKUP/groups/clin-agent-bench/dev/logs/*/docling.log'",
    "admin:recount-pg-ch-sync": "bun --env-file=.env.local scripts/recountPgChSync.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.9",
    "@ark-ui/solid": "^5.18.3",
    "@clickhouse/client": "^1.15.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/eden": "^1.4.6",
    "@elysiajs/static": "^1.4.7",
    "@internationalized/date": "^3.8.2",
    "@kobalte/core": "^0.13.11",
    "@tanstack/router-plugin": "^1.132.56",
    "@tanstack/solid-form": "^1.23.8",
    "@tanstack/solid-query": "^5.90.9",
    "@tanstack/solid-router": "^1.130.12",
    "@tanstack/solid-router-devtools": "^1.130.13",
    "@tanstack/solid-table": "^8.21.3",
    "ai": "^5.0.9",
    "arktype": "^2.1.20",
    "better-auth": "^1.3.34",
    "chart.js": "^4.5.0",
    "chdb-bun": "github:chdb-io/chdb-bun",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.7",
    "elysia": "^1.4.21",
    "fast-xml-parser": "^5.2.5",
    "openai": "^5.12.2",
    "pg": "^8.16.3",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@better-auth-kit/seed": "^1.0.12",
    "@better-auth/cli": "^1.3.4",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/bun": "^1.2.19",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "baseline-browser-mapping": "^2.9.11",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.6",
    "drizzle-seed": "^0.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-vitest": "^0.5.4",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  },
  "module": "src/index.js"
}
