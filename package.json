{
  "name": "forska.ai",
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "start": "bun run start:build && bun run start:server & bun run start:app-server",
    "start:secondary": "bun run start:build && bun run start:secondary:server & bun run start:secondary:app-server",
    "start:build": "bun run build",
    "start:server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode server-stack",
    "start:secondary:server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode server-stack",
    "start:server:single": "bun run src/server/index.ts",
    "start:app-server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode app-server",
    "start:secondary:app-server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode app-server",
    "app": "bun run build && bun run preview",
    "build": "bunx --bun vite build",
    "bench:articlesreviews": "bun scripts/benchmarkArticlesReviews.ts",
    "bench:duckdb-append-lanes": "bun scripts/benchmarkDuckdbAppendLanes.ts",
    "preview": "bunx --bun vite preview",
    "test": "sh -c 'bun run test:bun; bun_status=$?; bun run test:vitest; vitest_status=$?; bun run test:playwright; playwright_status=$?; [ $bun_status -eq 0 ] && [ $vitest_status -eq 0 ] && [ $playwright_status -eq 0 ]'",
    "test:bun": "bun scripts/runBunTests.ts",
    "test:vitest": "bunx vitest run",
    "test:playwright": "bunx playwright test",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "dev:app": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode app",
    "dev:server": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode stacked-server",
    "dev:server:bun-watch": "BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:single": "BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:api": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode api-only-server",
    "dev:server:judge": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode judge-only-server",
    "dev:server:maintenance": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode maintenance-only-server",
    "dev:server:api-only": "SERVER_ROLE=api SERVER_DUCKDB_OWNER_URL= BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:server:duckdb-owner": "SERVER_ROLE=maintenance-worker BUN_CONFIG_MAX_HTTP_REQUESTS=2048 bun run --watch src/server/index.ts",
    "dev:secondary:server": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode stacked-server",
    "dev:secondary:app": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode app",
    "dev:secondary:server:api": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode api-only-server",
    "dev:secondary:server:judge": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode judge-only-server",
    "dev:secondary:server:maintenance": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode maintenance-only-server",
    "desktop:dev": "bun run build && electrobun dev --watch",
    "desktop:build": "bun run build && electrobun build",
    "db:mig": "bun scripts/runWithRuntimeProfile.ts --profile primary --mode duckdb-migration",
    "db:mig:secondary": "bun scripts/runWithRuntimeProfile.ts --profile secondary --mode duckdb-migration",
    "db:duck:mig": "bun run db:mig",
    "db:backup": "bun scripts/dbBackup.ts",
    "db:judgment-job:sqlite-import": "bun scripts/runJudgmentJobSqliteSingleJobImport.ts",
    "db:judgment-job:repair": "bun scripts/runJudgmentJobRepair.ts",
    "db:duck:checkpoint": "bun scripts/duckdbCheckpoint.ts",
    "db:query:snapshot": "bun scripts/dbQuerySnapshot.ts",
    "db:duck:inspect-dirty-refresh-risk": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/inspectDirtyRefreshRisk.ts",
    "db:duck:request-project-large-rebuild": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/requestProjectLargeRebuild.ts",
    "db:duck:request-review-serving-large-rebuild": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/requestReviewServingLargeRebuild.ts",
    "db:duck:run-large-rebuild-worker-once": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/runLargeRebuildWorkerOnce.ts",
    "db:duck:run-large-rebuild-worker-cycles": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/runLargeRebuildWorkerCycles.ts",
    "db:duck:quarantine-dirty-refresh-article": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/quarantineDirtyRefreshArticle.ts",
    "db:duck:unquarantine-dirty-refresh-article": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/unquarantineDirtyRefreshArticle.ts",
    "db:duck:recover-dirty-refresh-claims": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/recoverDirtyRefreshClaims.ts",
    "db:duck:request-judgment-fact-repair": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/requestJudgmentFactRepair.ts",
    "db:duck:rebuild2-cutover": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/rebuild2Cutover.ts",
    "db:duck:run-archived-project-bounded-cleanup": "SERVER_ROLE=maintenance-worker SERVER_DUCKDB_OWNER_URL= bun scripts/runArchivedProjectBoundedCleanup.ts",
    "db:duck:backfill-source-metadata": "bun scripts/backfillArticleSourceMetadata.ts",
    "db:duck:backfill-ppr-host-labels": "bun scripts/backfillPprHostLabels.ts",
    "db:studio": "bun scripts/dbStudio.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@ark-ui/solid": "^5.34.1",
    "@duckdb/node-api": "^1.5.1-r.1",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/cron": "^1.4.1",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/static": "^1.4.7",
    "@internationalized/date": "^3.12.0",
    "@kobalte/core": "^0.13.11",
    "@tanstack/router-plugin": "^1.166.7",
    "@tanstack/solid-form": "^1.28.5",
    "@tanstack/solid-query": "^5.90.26",
    "@tanstack/solid-router": "^1.166.7",
    "@tanstack/solid-router-devtools": "^1.166.7",
    "@tanstack/solid-table": "^8.21.3",
    "@zip.js/zip.js": "^2.7.73",
    "ai": "^6.0.116",
    "arktype": "^2.2.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "effect": "^3.20.0",
    "electrobun": "^1.16.0",
    "elysia": "^1.4.27",
    "fast-xml-parser": "^5.5.5",
    "openai": "^6.27.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/bun": "^1.3.10",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "baseline-browser-mapping": "^2.10.7",
    "bun-types": "^1.3.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript-bun": "^0.0.104",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-vitest": "^0.5.4",
    "happy-dom": "^20.8.9",
    "jiti": "^2.6.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "vite": "^8.0.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.0"
  },
  "module": "src/index.js"
}
