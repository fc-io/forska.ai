From: Forska maintainers
Subject: Preserve truncated string maximum bounds when merging longer prefixes

Base: DuckDB 816a3eb2d512ce359efb40d9319f6db59788422a
A shorter truncated maximum includes all suffixes of its prefix. Do not narrow
it to a longer exact or truncated bound when merging update statistics.

diff --git a/src/storage/statistics/string_stats.cpp b/src/storage/statistics/string_stats.cpp
--- a/src/storage/statistics/string_stats.cpp
+++ b/src/storage/statistics/string_stats.cpp
@@ -617,6 +617,22 @@
 		target_type = source_type;
 		return;
 	}
+	if (!is_min && source.GetSize() != target.GetSize()) {
+		const bool source_is_shorter = source.GetSize() < target.GetSize();
+		const auto &shorter = source_is_shorter ? source : target;
+		const auto &longer = source_is_shorter ? target : source;
+		const auto shorter_type = source_is_shorter ? source_type : target_type;
+		// A truncated maximum includes every suffix of its prefix. A longer bound with that
+		// prefix is therefore less extreme, even though ordinary string comparison orders it higher.
+		if (shorter_type == StringStatsType::TRUNCATED_STATS &&
+		    (shorter.GetSize() == 0 || memcmp(shorter.GetData(), longer.GetData(), shorter.GetSize()) == 0)) {
+			if (source_is_shorter) {
+				target = AssignString(stats, source, is_min);
+				target_type = source_type;
+			}
+			return;
+		}
+	}
 	// both min/max stats are there - compare
 	auto comparison = Comparator::Operation(source, target);
 	if (comparison == 0) {
